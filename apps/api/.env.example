# General
API_NAME=ptp-api
NODE_ENV=local
# API_URL is set by default as authentication base url
API_URL=http://localhost:3000
# WEB_URL is automatically added to CORS and Auth trusted urls config
WEB_URL=http://localhost:3001

# POSTGRES
POSTGRES_USER=bobby
POSTGRES_PASSWORD=tables
POSTGRES_DB=ptp-local

# DB
DB_HOST=localhost
DB_PORT=5432
# Avoid using the public schema when possible
# https://cybernerdie.medium.com/postgresql-schemas-explained-the-missing-tool-for-clean-scalable-database-design-f6980622528e
DB_SCHEMA=public

# Prisma database connection
# Used by the prisma.config.ts and the docker-compose.dev.yaml
# Nest.js config service uses the POSTGRES and DB values directly, since the PrismaPg
# adapter doesn't support variable inference
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}?schema=${DB_SCHEMA}&sslmode=prefer

# Nest
PORT=3000

# CORS
CORS_ENABLED=true

# Swagger
SWAGGER_ENABLED=true
SWAGGER_TITLE="PabloTor Platform"
SWAGGER_DESCRIPTION="The PTP API description"
SWAGGER_VERSION="1.0"
SWAGGER_PATH=api

# AUTH
AUTH_SECRET=
AUTH_TRUSTED_URL=[]