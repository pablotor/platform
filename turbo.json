{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env.local", ".env.development"],
      "env": [
        "AUTH_SECRET",
        "AUTH_URL",
        "AUTH_TRUSTED_URLS",
        "DATABASE_URL",
        "PORT",
        "CORS_ENABLED",
        "SWAGGER_ENABLED",
        "SWAGGER_TITLE",
        "SWAGGER_DESCRIPTION",
        "SWAGGER_VERSION",
        "SWAGGER_PATH"
      ]
    },
    "lint": {},
    "test": {},
    "test:e2e": {}
  }
}
