{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./styles.css": "./dist/index.css",
    "./tiptap.css": "./dist/tiptap.css",
    "./theme.css": "./src/theme.css",
    "./*": "./dist/*.js"
  },
  "license": "MIT",
  "scripts": {
    "build:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
    "build:tiptap": "sass ./src/tiptap/styles/entry.scss ./dist/tiptap.css",
    "build:components": "tsc",
    "check-types": "tsc --noEmit",
    "dev:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
    "dev:tiptap": "sass --watch ./src/tiptap/styles/entry.scss ./dist/tiptap.css",
    "dev:components": "tsc --watch",
    "lint": "eslint src --max-warnings 0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@tailwindcss/cli": "^4.3.0",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.31.0",
    "sass": "^1.102.0",
    "sass-embedded": "^1.100.0",
    "tailwindcss": "^4.3.0",
    "typescript": "5.9"
  },
  "peerDependencies": {
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.16",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@radix-ui/react-avatar": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-toast": "^1.2.17",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-highlight": "^3.29.2",
    "@tiptap/extension-horizontal-rule": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-list": "^3.29.2",
    "@tiptap/extension-subscript": "^3.29.2",
    "@tiptap/extension-superscript": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-typography": "^3.29.2",
    "@tiptap/extensions": "^3.29.2",
    "@tiptap/markdown": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lodash.throttle": "^4.1.1",
    "react-hotkeys-hook": "^5.3.3"
  }
}
